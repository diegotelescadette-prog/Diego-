# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Para a stack local de testes, veja docs/TESTES.md.

# Nome do app (fácil de trocar)
NEXT_PUBLIC_APP_NAME="Próximo"

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Chave privilegiada: SOMENTE no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# URL pública do site (links de confirmação de e-mail e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de 32 bytes em base64 para cifrar o CPF (gere com: openssl rand -base64 32)
CPF_ENCRYPTION_KEY=

# Sal para gerar o hash do IP usado nos limites de frequência (openssl rand -hex 16)
RATE_LIMIT_SALT=
